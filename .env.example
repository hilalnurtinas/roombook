# Copy to .env and fill in for local development. Never commit .env.

# Async SQLAlchemy URL for the app's database.
DATABASE_URL=postgresql+asyncpg://roombook:roombook@localhost:5432/roombook

# Async SQLAlchemy URL for the test suite's database (must be a separate database).
TEST_DATABASE_URL=postgresql+asyncpg://roombook:roombook@localhost:5432/roombook_test
